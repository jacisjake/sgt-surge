# ─── Schwab Authentication ───────────────────────────────────────────────────
# NEVER commit your actual .env file to version control.
#
# 1. Create a developer app at https://developer.schwab.com
# 2. Note your App Key and App Secret
# 3. Set SCHWAB_ACCOUNT_HASH to your account's hashed account number
#    (retrieved via GET /accounts after completing OAuth flow)
#
SCHWAB_APP_KEY=your_app_key
SCHWAB_APP_SECRET=your_app_secret
SCHWAB_ACCOUNT_HASH=your_account_hash

# OAuth redirect URI — must match what you registered in the Schwab developer portal.
# Default works if running behind the standard Caddy reverse proxy.
# SCHWAB_OAUTH_REDIRECT_URI=https://your-domain.com/schwab/oauth/callback

# Path to persist the OAuth token across restarts (relative to project root).
# SCHWAB_TOKEN_PATH=state/schwab_token.json

# ─── Trading Mode ──────────────────────────────────────────────────────────────
# 'dry_run' = simulated fills (no real money), 'live' = real money
TRADING_MODE=dry_run

# ─── Risk Management ──────────────────────────────────────────────────────────
# Max risk per trade as fraction of account (0.02 = 2%)
MAX_POSITION_RISK_PCT=0.02

# Max total portfolio risk as fraction of account (0.10 = 10%)
MAX_PORTFOLIO_RISK_PCT=0.10

# Max concurrent open positions
MAX_POSITIONS=5

# Max drawdown before halting trading (0.15 = 15%)
MAX_DRAWDOWN_PCT=0.15

# ─── Logging ──────────────────────────────────────────────────────────────────
# DEBUG, INFO, WARNING, or ERROR
LOG_LEVEL=INFO
